# ---------------------------------------------------------------
# WAR ATLAS — environment variables (copy to .env and adjust)
# Never commit the real .env file.
# ---------------------------------------------------------------

ENVIRONMENT=development

# PostgreSQL / PostGIS
POSTGRES_DB=waratlas
POSTGRES_USER=waratlas
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_PORT=5432

# Backend (FastAPI)
# Used when running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://waratlas:choose-a-local-password@localhost:5432/waratlas
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
BACKEND_PORT=8000
# Seed verifiable initial data on container start (idempotent)
SEED_ON_START=true
# Allow admin importers (Wikidata) to make outbound HTTP requests
IMPORTERS_ENABLED=true
# Optional: bootstrap an admin account on start (only created if it does not exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend (Vite) — empty values use the defaults documented in docs/MAPS.md
FRONTEND_PORT=8080
VITE_API_URL=/api/v1
# Font glyphs for map labels (MapLibre). Default: OpenFreeMap fonts.
VITE_GLYPHS_URL=
# Optional modern reference vector tiles (OpenMapTiles schema TileJSON). Default: OpenFreeMap.
# Set to "off" to disable.
VITE_MODERN_TILES_URL=
# Terrain-RGB/Terrarium DEM tiles for hillshade. Default: AWS Open Data Terrain Tiles.
# Set to "off" to disable.
VITE_TERRAIN_TILES_URL=
